# Copy to backend/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/campus_events
# Production: your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/campus_events

# Long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of frontend origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:3000

# "lax" when frontend and API share a site (e.g. app.example.com + api.example.com).
# "none" when they are on different sites (e.g. *.vercel.app + *.onrender.com) — requires HTTPS.
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (Render/Railway/Nginx: 1, local: 0).
TRUST_PROXY=0

# Email of the platform super admin, used by `npm run create-admin`.
SUPER_ADMIN_EMAIL=

# The university this deployment serves (tenant data only).
DEFAULT_UNIVERSITY_SLUG=mit-wpu
DEFAULT_UNIVERSITY_NAME=MIT World Peace University
DEFAULT_UNIVERSITY_SHORT_NAME=MIT-WPU

# Public URL of the frontend (used for links in emails). Defaults to the first CLIENT_ORIGINS entry.
APP_URL=http://localhost:3000

# Optional email (registration confirmations, cancellation notices).
# Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Event Engine <no-reply@your-domain.com>
APP_TIME_ZONE=Asia/Kolkata

# Optional overrides (requests per 15 minutes)
# AUTH_RATE_LIMIT=10
# API_RATE_LIMIT=1500   (per signed-in user; per IP for anonymous visitors)
